# Draftly Backend Configuration
# Copy this file to .env and fill in the values

# ===========================================
# REQUIRED: Google AI API Key (for Gemini)
# ===========================================
# Get your API key from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key-here

# ===========================================
# REQUIRED: JWT Secret Key
# ===========================================
# Generate a secure secret key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production

# ===========================================
# OPTIONAL: Database URL
# ===========================================
# Default: sqlite:///./draftly.db (SQLite for development)
# For production with PostgreSQL: postgresql://user:password@host:port/database
DATABASE_URL=sqlite:///./draftly.db

# ===========================================
# OPTIONAL: JWT Token Expiration
# ===========================================
# Token expiration time in minutes (default: 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===========================================
# OPTIONAL: Frontend Origins (CORS)
# ===========================================
# Comma-separated list of allowed frontend origins
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000,https://draftly.site
